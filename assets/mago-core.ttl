@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix mago: <https://www.microarea.it/ontology#> .

<https://www.microarea.it/ontology/core>
    a owl:Ontology .

# Classes

mago:Object a owl:Class .

mago:Document a owl:Class ;
    rdfs:subClassOf mago:Object .

mago:DBT a owl:Class ;
    rdfs:subClassOf mago:Object .

mago:Field a owl:Class .

mago:namespace a owl:DatatypeProperty ;
    rdfs:domain mago:Object ;
    rdfs:range xsd:string .

mago:columnName a owl:DatatypeProperty ;
    rdfs:domain mago:Field ;
    rdfs:range xsd:string ;
    rdfs:comment "Database column name of the Field."@en .

mago:description a owl:DatatypeProperty ;
    rdfs:range xsd:string .

mago:hasDBT a owl:ObjectProperty ;
    rdfs:domain mago:Document ;
    rdfs:range mago:DBT .

mago:hasField a owl:ObjectProperty ;
    rdfs:domain mago:DBT ;
    rdfs:range mago:Field .

mago:externalReference a owl:ObjectProperty ;
    rdfs:domain mago:Field ;
    rdfs:range mago:Document .

mago:DBTMaster a owl:Class ;
    rdfs:subClassOf mago:DBT ;
    rdfs:comment "Main DBT of the header of the Document ('1 to 1' cardinality)."@en .

mago:DBTSlave a owl:Class ;
    rdfs:subClassOf mago:DBT ;
    rdfs:comment "Slave DBT connected to the header in '1 to 1' relationship."@en .

mago:DBTSlaveBuffered a owl:Class ;
    rdfs:subClassOf mago:DBTSlave ;
    rdfs:comment "Slave buffered DBT (grid/detail) connected to the header in '1 to N' relationship."@en .

